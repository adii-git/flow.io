# Copy to .env. Generate secrets:
#   SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
FERNET_KEY=
POSTGRES_PASSWORD=change-me
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
# demo = simulated, labelled outputs and no keys needed. live = real providers (save keys in Tools).
EXECUTION_MODE=demo
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# Production only (docker-compose.prod.yml)
DOMAIN=localhost
# Optional local/open-source image generation. Leave blank to keep the local image tool unavailable.
# For Docker Desktop on Mac with Automatic1111/Forge running on the host:
# LOCAL_IMAGE_API_URL=http://host.docker.internal:7860/sdapi/v1/txt2img
LOCAL_IMAGE_API_URL=
